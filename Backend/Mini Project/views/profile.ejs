<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body>
    <div
      class="bg-zinc-900 w-full min-h-screen p-10 text-white"
    >
            <div class="flex justify-end">
                <a href="/logout" class="bg-red-500 px-3 py-2 rounded text-sm ">Logout</a>
            </div>

            <div class="flex items-start mb-5 items-center gap-4 ">
              <div class="w-10 h-10 rounded-md"><a href="/profile/upload"><img class="w-full h-full object-cover"  src= "/images/uploads/<%= user.profilepic %>" alt=""></a></div>
              
              <h1 class="text-3xl"><span class="font-light">Hello,</span> <%= user.name %> 👋</h1>
            </div>
            <h5>You can create a new post</h5>
    


            <div class="mt-10">
                      <form action="/post" method="post" class="flex flex-col w-1/6 items-start">
                    <textarea class="bg-transparent resize-none w-full p-3 border border-zinc-600 rounded-md" name="content" id="" placeholder="Whats on your mind"></textarea>
                    <input class="mt-2 border border-zinc-600 px-2 py-3 rounded bg-blue-500" type="submit" value="Create New Post" name="" id="">
                </form>   
            </div>

            <div class="mt-10 ">
                <h1 class="text-zinc-600">Your Posts</h1>
                <div class="postcontainer flex gap-2 flex-wrap">

                    <% user.posts.reverse().forEach((post)=>{ %>

                                <div class="post w-1/3 p-5 bg-zinc-700">
                           <h4 class="mb-2 text-blue-500">@<%=user.username%></h4>
                           <p><%= post.content%></p>
                            <h1 class="mt-1"><span class="text-white"><%= post.likes.length %></span> Likes</h1>
                           <div class="btns mt-2 flex gap-4">
                            <a href="/like<%= post._id %>" class="text-blue-500"><%= post.likes.indexOf(user._id) === -1 ? "Like" : "Unlike" %></a>
                            
                            <a href="/edit/<%= post._id%>" class="text-zinc-500">Edit</a>
                            <a href="/delete/<%= post._id%>" class="text-zinc-500">Delete</a>

                           </div>
                    </div>  

                   <% })%>


                

                      
                  
                </div>
            </div>
               
    
    </div>



  </body>
</html>
