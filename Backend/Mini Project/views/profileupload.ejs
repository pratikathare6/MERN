<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body>
    <div
      class="bg-zinc-900 w-full min-h-screen p-10 text-white"
    > 

            <div class="flex items-start mb-5 items-center gap-4 ">
              <div class="w-10 h-10 rounded-md"><img class="w-full h-full object-cover" src= "/images/uploads/<%= user.profilepic %>" alt=""></div>
              
              <h1 class="text-3xl"><span class="font-light">Hello,</span> <%= user.name %> 👋</h1>
            </div>
            <h5>Update a profile</h5>
    


            <div class="mt-10">
                      <form action="/upload" method="post" class="flex flex-col w-1/6 items-start" enctype="multipart/form-data">
                    <input type="file" name="uploadprofile">
                    <input class="mt-2 border border-zinc-600 px-2 py-3 rounded bg-blue-500" type="submit" value="Update" name="" id="">
                    
                </form>   
            </div>

          
               
    
    </div>



  </body>
</html>
