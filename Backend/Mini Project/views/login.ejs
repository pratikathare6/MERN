<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body>
    <div
      class="bg-zinc-900 w-full min-h-screen p-10 text-white flex justify-center flex-col items-center"
    >
      <form action="/login" method="post" class="flex flex-col gap-3 w-1/4">
        <input
          type="email"
          class="px-4 py-3 rounded-md bg-transparent border border-zinc-600"
          placeholder="Email"
          name="email"
        />
        <input
          type="password"
          class="px-4 py-3 rounded-md bg-transparent border border-zinc-600"
          placeholder="Password"
          name="password"
        />
        <input
          type="submit"
          class="border px-4 py-3 rounded-md bg-blue-500 active:scale-95"
          value="Login"
        />
      </form>
      <span class="font-bold text-md">or</span>
      <a href="/" class="text-blue-500 text-xl font-bold underline">Register</a>
    </div>
  </body>
</html>
