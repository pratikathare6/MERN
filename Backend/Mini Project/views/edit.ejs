<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body>
    <div
      class="bg-zinc-900 w-full min-h-screen p-10 text-white"
    >
            <div class="flex justify-end">
                <a href="/logout" class="bg-red-500 px-3 py-2 rounded text-sm ">Logout</a>
            </div>
            <h1>Update Post</h1>
    


            <div class="mt-10">
                      <form action="/edit/<%= post._id%> " method="post" class="flex flex-col w-1/6 items-start">
                    <textarea class="bg-transparent resize-none w-full p-3 border border-zinc-600 rounded-md" name="content" id="" placeholder="Whats on your mind"><%=post.content %></textarea>
                    <input class="mt-2 border border-zinc-600 px-2 py-3 rounded bg-blue-500" type="submit" value="Update Post" name="" id="">
                </form>   
            </div>

            
            
               
    
    </div>



  </body>
</html>
