<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>

    <link rel="stylesheet" href="../public/style.css" />

    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body>
    <div class="w-full min-h-screen p-10 text-white bg-zinc-600">
    <a href="/" class="text-blue-500">Back to Home</a>
    <h1 class="font-bold text-xl">All Users</h1>

      <div class="flex flex-wrap gap-2">

        <%if(allusers.length == 0){%>

          <div><h3>No User yet</h3></div>

        <%}else{%>

            <% allusers.forEach(function(user){ %>
            <div class="w-72 h-58 rounded bg-zinc-400 mt-2">

          <img class="w-full h-44  object-cover p-2 rounded" src= <%= user.imgurl %> alt="" >
          <h1 class="ml-2 font-xl text-black font-bold "><%= user.username %></h1>
          <h3 class="ml-2 text-zinc-600"><%= user.email %></h3>
          <div class="flex justify-between items-center p-2 ">
            <a href="/edit/<%= user._id %>" class="text-blue-500 font-bold">Edit </a>
          <a href="/delete/<%= user._id%>" class="text-red-500 font-bold">Delete </a>
          </div>
        
        </div>
        <%  }) %>

        <%}%>
      </div>

    </div>

  </body>
</html>
